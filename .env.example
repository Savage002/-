# Copy this file to .env and fill in real values. Never commit .env.

# --- Database ---
DB_USER=postgres
DB_PASSWORD=change_me_to_a_strong_random_password
DB_NAME=zqai_db
DB_HOST=localhost
DB_PORT=5432

# --- Backend server ---
PORT=3001
NODE_ENV=production
# Generate with: openssl rand -base64 48
JWT_SECRET=change_me_to_a_long_random_secret
# Comma-separated list of origins allowed to call the API (no trailing slash)
CORS_ORIGIN=http://localhost:5005

# --- Frontend build/dev (Vite) ---
VITE_API_TARGET=http://localhost:3001
